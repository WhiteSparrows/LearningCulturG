<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- DayNight : la WebView suit ainsi le thème clair ou sombre du téléphone. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/culturg_paper</item>
        <item name="android:navigationBarColor">@color/culturg_paper</item>
        <item name="android:windowLightStatusBar">@bool/culturg_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/culturg_light_bars</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/culturg_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_g</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
